# Copy this file to .env and set your values. Never commit .env.

# Required. Generate a new one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# --- Email ---
# Console backend: emails appear ONLY in the terminal running runserver (no real inbox).
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# Real inbox (example Gmail SMTP — use an App Password if 2FA is on):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your.address@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=DocSphere <your.address@gmail.com>
